{
  "name": "the-tech-shed-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A database-free landing page and blog for The Tech Shed.",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "node .eleventy/clean.mjs && eleventy",
    "check:links": "node .eleventy/check-internal-links.mjs",
    "test": "node --test workers/*/test/*.test.js",
    "deploy:mac-lookup": "wrangler deploy --config workers/mac-lookup/wrangler.jsonc",
    "deploy:dns-lookup": "wrangler deploy --config workers/dns-lookup/wrangler.jsonc",
    "debug": "DEBUG=Eleventy* eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.2"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
