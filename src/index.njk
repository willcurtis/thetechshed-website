<section class="section section-alt" id="notes">
  <div class="container">
    <header class="section-heading"><p class="eyebrow">Project notes</p><h2>From the notebook.</h2></header>
    <div class="notes-grid">
      {% for post in collections.posts | reverse | limit(3) %}
      <article class="note-card{% if post.data.previewImage %} note-card--visual{% endif %}">
        {% if post.data.previewImage %}<a class="note-card-image" href=".{{ post.url }}index.html" aria-label="Read {{ post.data.title }}"><img src=".{{ post.data.previewImage }}" width="1280" height="720" alt="{{ post.data.previewImageAlt }}" loading="lazy" decoding="async"></a>{% endif %}
        <div class="card-kicker-row"><p class="project-type">{{ post.data.category }}</p>{% if post.data.projectStatus %}<span class="status-chip">{{ post.data.projectStatus }}</span>{% endif %}</div>
        <h3><a href=".{{ post.url }}index.html">{{ post.data.title }}</a></h3><p>{{ post.data.description }}</p><time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time>
      </article>
      {% endfor %}
    </div>
    <a class="text-link" href="./blog/index.html">View all project notes →</a>
  </div>
</section>

<section class="section contact" id="contact">
  <div class="container contact-inner"><div><p class="eyebrow">Contact</p><h2>Let’s compare notes.</h2><p>Have a question, an idea or a gloriously over-engineered problem?</p></div><a class="contact-email" href="mailto:{{ site.email }}">{{ site.email }} <span aria-hidden="true">↗</span></a></div>
</section>
